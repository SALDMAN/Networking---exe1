# Copy to .env and fill in. .env is git-ignored; never commit or ZIP it.
# Only LLM_API_KEY is required for Gemini. The others are optional.
# LLM_PROVIDER: "gemini" (Google) or "openai" (any OpenAI-compatible server: Cloudflare, Groq, OpenRouter...)
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Needed for LLM_PROVIDER=openai. Cloudflare Workers AI example (put your account ID in):
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# Ask the server for JSON output (only some models support it): true or false
# LLM_JSON_MODE=false
# seconds to wait for one LLM answer
LLM_TIMEOUT=60
# 0 = most repeatable answers
LLM_TEMPERATURE=0
# how many HTTP transactions are sent to the model per question
LLM_MAX_TRANSACTIONS=200
